{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!.claude",
      "!docs",
      "!assets",
      "!levels/generated",
      "!kenney_pixel-platformer",
      "!scripts/*.mjs",
      "!pnpm-lock.yaml",
      "!**/dist",
      "!**/coverage",
      "!**/playwright-report",
      "!**/test-results",
      "!.preview",
      "!**/*.md",
      "!**/*.yml",
      "!**/*.yaml"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noConsole": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useImportType": "error"
      },
      "correctness": {
        "useImportExtensions": {
          "level": "error",
          "options": {
            "forceJsExtensions": false
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "phaser": "domain é puro: sem Phaser (ADR 0004)."
                },
                "patterns": [
                  {
                    "group": [
                      "phaser/**",
                      "**/game",
                      "**/game/**",
                      "**/ui",
                      "**/ui/**",
                      "**/storage",
                      "**/storage/**"
                    ],
                    "message": "domain é puro: não importa outras camadas (ADR 0004)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/game/**", "!**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noFocusedTests": "off"
          }
        }
      }
    }
  ]
}
