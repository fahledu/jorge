{
  "name": "jorge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "24.22.3"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-dist.ts",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview": "vite preview",
    "preview:e2e": "vite preview --outDir dist-e2e",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:quiet": "vitest run --reporter=agent",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "levels:build": "node scripts/build-levels.ts",
    "levels:check": "node scripts/check-levels.ts",
    "levels:preview": "node scripts/level-preview.ts"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "4.1.12",
    "typescript": "6.0.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
